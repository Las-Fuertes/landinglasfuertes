# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-9ZXP5ZNDT1

# Environment
NODE_ENV=development

# API endpoints (if needed in the future)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Sección "Súmate" ---
# Bold (donación única). Llave de identidad, segura para el frontend.
# Se obtiene en el panel de Bold: Integraciones > Llaves de integración.
NEXT_PUBLIC_BOLD_API_KEY=
# Llave secreta de Bold. SOLO servidor: nunca prefijarla con NEXT_PUBLIC.
BOLD_SECRET_KEY=
# La llave de identidad (NEXT_PUBLIC_BOLD_API_KEY) también la usa /api/estado-pago para
# consultar el estado real de la transacción en Bold (docs/mixpanel/DECISIONES.md, D6).

# Mercado Pago: Access Token de PRODUCCIÓN (APP_USR-...) de la cuenta dueña del plan mensual.
# SOLO servidor: nunca prefijarlo con NEXT_PUBLIC. Lo usa /api/estado-pago para leer el estado
# de la suscripción (GET /preapproval/{id}). Sin él, /gracias cae a lo que dice la URL.
# Se obtiene en Mercado Pago Developers: Tus integraciones > la aplicación > Credenciales de producción.
MP_ACCESS_TOKEN=
# El enlace del plan mensual de Mercado Pago ya no va aquí: vive en
# components/sumate/sumate.data.ts (MP_SUBSCRIPTION_URL). URL de retorno del plan en MP:
# https://<dominio>/gracias . Mercado Pago le añade ?preapproval_id=<id> y /gracias muestra el
# gracias mensual (docs/mixpanel/DECISIONES.md, D5). El viejo ?origen=suscripcion sigue valiendo.
# Número de WhatsApp de la fundación con indicativo, sin + (ej. 573001234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Usuario de Instagram (con o sin @).
NEXT_PUBLIC_INSTAGRAM_HANDLE=

# URL pública del sitio (para Open Graph y metadatos). Sin slash final.
NEXT_PUBLIC_SITE_URL=
